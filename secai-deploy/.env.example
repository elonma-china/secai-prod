# secai-deploy configuration. Copy to .env and fill in before `docker compose up -d`.
# The gateway is deliberately unauthenticated — keep it behind apply_firewall.sh / a VPN.
# All keys map 1:1 to secai_gateway.config.Settings (case-insensitive). Path settings
# (EXPLOITDB_ROOT, BM25_DIR, POC_*, GATEWAY_DB_PATH, SEARCHSPLOIT_BIN) are pinned in
# docker-compose.yml's `environment:` block — don't set them here, they'll be ignored.

# ── LLM provider ──────────────────────────────────────────────────────────────
# vast.ai serving host/port are EPHEMERAL (reassigned on every rental) — fetch the current
# values from your vast.ai serving instance (secai-serving-vast/serving-status.sh) before
# each deploy, or point at a different LLM/embedding/reranker backend entirely.
LLM_PROVIDER=vllm
QWEN_BASE_URL=http://<vast-host>:<port>/v1
QWEN_API_KEY=sk-your-serving-key
QWEN_MODEL=DuyTa/Cyber-F1-AWQ
QWEN_CONTEXT_WINDOW=65536
# DeepSeek fallback (used when LLM_PROVIDER=deepseek)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_CONTEXT_WINDOW=131072

# ── Retrieval: embedding/reranker (also on the vast.ai host above) ────────────
EMBEDDING_API_URL=http://<vast-host>:<port>
RERANKER_API_URL=http://<vast-host>:<port>
EMBEDDING_API_KEY=sk-your-serving-key
RERANKER_API_KEY=sk-your-serving-key
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B

# ── Knowledge graph: Neo4j ─────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# ── Gateway ────────────────────────────────────────────────────────────────────
ADMIN_API_KEY=change-me-admin-key
# CORS: comma-separated frontend origins, or * (current project default — FE calls
# server-to-server, so CORS isn't the access-control boundary; the firewall allowlist is).
ALLOWED_ORIGINS=*
