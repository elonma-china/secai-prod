{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "cocoindex-code": {
      "type": "local",
      "command": ["/home/ict/.local/bin/ccc", "mcp"],
      "cwd": "/home/ict/AIEngines/secai/secai-agent-gateway",
      "timeout": 60000
    },
    "playwright": {
      "type": "local",
      "command": [
        "/home/ict/.nvm/versions/node/v24.15.0/bin/npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated"
      ],
      "timeout": 120000
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "/home/ict/.nvm/versions/node/v24.15.0/bin/npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated",
        "--no-usage-statistics",
        "-e",
        "/usr/bin/google-chrome"
      ],
      "environment": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
      },
      "timeout": 120000
    }
  }
}
