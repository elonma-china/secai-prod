[Unit]
Description=SECAI Agent Gateway (IAS v2, new) — port 8131
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ict
WorkingDirectory=/home/ict/AIEngines/secai-agent-gateway
# '+' runs as root regardless of User=ict, so the allowlist is (re)applied before uvicorn
# binds :8131 on every start/restart/reboot — the port is never briefly unfiltered.
ExecStartPre=+/home/ict/AIEngines/secai-agent-gateway/deploy/apply_firewall.sh
ExecStart=/home/ict/AIEngines/secai-agent-gateway/.venv/bin/python -m uvicorn secai_gateway.app:app --host 0.0.0.0 --port 8131
Restart=always
RestartSec=5
StandardOutput=append:/home/ict/AIEngines/secai-agent-gateway/gateway.log
StandardError=append:/home/ict/AIEngines/secai-agent-gateway/gateway.log

[Install]
WantedBy=multi-user.target
