+_PROXY_HEADERS = ("cf-connecting-ip", "x-real-ip", "x-forwarded-for")
+
+
+def _client_ip(request: Request) -> str:
+    """IP người dùng THẬT cho giới hạn theo IP. Dịch vụ nằm sau proxy (IAS -> cổng 8131 -> :18185): `request.client.host` luôn là
+    địa chỉ nội bộ của container gateway nên mọi người dùng dùng CHUNG một bộ đếm (5 upload/phút, 5 job cho cả hệ thống).
+    Chỉ tin header chuyển tiếp khi kết nối trực tiếp đến từ mạng nội bộ (loopback/private); nếu không thì dùng địa chỉ kết nối."""
+    host = request.client.host if request.client else "unknown"
+    try:
+        direct = ipaddress.ip_address(host)
+    except ValueError:
+        return host
+    if not (direct.is_private or direct.is_loopback):
+        return host
+    for name in _PROXY_HEADERS:
+        for token in request.headers.get(name, "").split(","):
+            try:
+                candidate = ipaddress.ip_address(token.strip())
+            except ValueError:
+                continue
+            if not (candidate.is_loopback or candidate.is_unspecified):
+                return str(candidate)  # địa chỉ hợp lệ đầu tiên (người dùng mạng LAN cũng là một IP riêng)
+    return host
+
