@@ -0,0 +1,133 @@
+"""Bounded XLSX extraction: one block per translatable text cell, structure kept in metadata.
+
+The workbook is untrusted. The OOXML package is vetted without openpyxl first (zip-bomb limits,
+macros/embedded objects/external links/connections rejected), then openpyxl reads the cells.
+openpyxl is imported lazily so the gateway still imports when it is missing. No network access.
+
+Policy: only string cells that contain at least one letter are translated. Numbers, dates,
+booleans, errors, formulas (data type ``f`` or text starting with ``=``) and empty cells are
+never touched. Sheet names are not translated but ride in every block's metadata. Hidden and
+very-hidden sheets ARE read (their ``sheet_state`` is reported) so nothing is silently dropped.
+"""
+from __future__ import annotations
+
+import importlib.util
+import re
+from pathlib import Path
+from typing import Any
+
+from .documents import _make_blocks, _safe_zip, _xml
+from .settings import TranslationSettings
+from .types import ExtractedDocument, TranslationError, WarningItem
+
+_BAD_PARTS = ("vbaproject", "activex", "embeddings/", "oleobject", "externallinks/",
+              "connections.xml", "querytables/", "macrosheets/", "dialogsheets/", "customui")
+_XML_DECL = re.compile(rb"<!\s*(?:DOCTYPE|ENTITY)", re.I)
+_OLE = b"\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1"
+_MAIN_TYPE = b"spreadsheetml.sheet.main+xml"
+
+
+def xlsx_dependencies_available() -> bool:
+    return importlib.util.find_spec("openpyxl") is not None
+
+
+def _load_openpyxl() -> Any:
+    try:
+        import openpyxl
+    except ImportError as exc:  # pragma: no cover - exercised through monkeypatch
+        raise TranslationError("DEPENDENCY_UNAVAILABLE", "XLSX support is unavailable.") from exc
+    return openpyxl
+
+
+def _vet_package(path: Path, settings: TranslationSettings) -> int:
+    """Zip-level and OOXML-level checks; returns the declared sheet count."""
+    with path.open("rb") as handle:
+        head = handle.read(8)
+    if head == _OLE:  # Office-encrypted workbooks (and legacy .xls) are CFB containers
+        raise TranslationError("UNSAFE_DOCUMENT", "Encrypted or legacy workbooks are unsupported.")
+    limits = settings.model_copy(update={
+        "max_docx_entries": settings.xlsx_max_entries,
+        "max_docx_inflated_bytes": settings.xlsx_max_inflated_bytes,
+        "max_docx_ratio": settings.xlsx_max_ratio})
+    parts = _safe_zip(path, limits)
+    if "[Content_Types].xml" not in parts or "xl/workbook.xml" not in parts:
+        raise TranslationError("CORRUPT_DOCUMENT", "Workbook parts are missing.")
+    content_types = parts["[Content_Types].xml"]
+    if b"macroEnabled" in content_types:
+        raise TranslationError("UNSAFE_DOCUMENT", "Macro-enabled workbooks are unsupported.")
+    if _MAIN_TYPE not in content_types:
+        raise TranslationError("FILE_TYPE_MISMATCH", "File type does not match extension.")
+    for name, data in parts.items():
+        low = name.lower()
+        if any(bad in low for bad in _BAD_PARTS):
+            raise TranslationError("UNSAFE_DOCUMENT", "Active or external workbook content is unsupported.")
+        if low.endswith(".rels"):
+            for rel in _xml(data):
+                if rel.attrib.get("TargetMode", "").lower() == "external":
+                    raise TranslationError("UNSAFE_DOCUMENT", "External workbook links are unsupported.")
+        elif low.endswith(".xml") and _XML_DECL.search(data):
+            raise TranslationError("UNSAFE_DOCUMENT", "Document contains unsafe XML.")
+    sheets = [node for node in _xml(parts["xl/workbook.xml"]).iter() if node.tag.endswith("}sheet")]
+    if not sheets:
+        raise TranslationError("CORRUPT_DOCUMENT", "Workbook has no sheets.")
+    if len(sheets) > settings.xlsx_max_sheets:
+        raise TranslationError("TEXT_TOO_LONG", "Workbook has too many sheets.")
+    return len(sheets)
+
+
+def _translatable(cell: Any) -> bool:
+    value = cell.value
+    if not isinstance(value, str) or cell.data_type not in {"s", "inlineStr", "str"}:
+        return False
+    stripped = value.strip()
+    return bool(stripped) and not stripped.startswith("=") and any(c.isalpha() for c in stripped)
+
+
+def extract_xlsx(path: Path, settings: TranslationSettings) -> ExtractedDocument:
+    openpyxl = _load_openpyxl()
+    _vet_package(path, settings)
+    cap = min(settings.xlsx_max_cells, settings.max_chunks, settings.max_blocks)
+    try:
+        with path.open("rb") as handle:  # artifact files have no .xlsx suffix
+            workbook = openpyxl.load_workbook(handle, data_only=False, keep_links=False,
+                                              keep_vba=False, rich_text=False)
+    except TranslationError:
+        raise
+    except Exception as exc:  # openpyxl raises many distinct types on malformed input
+        raise TranslationError("CORRUPT_DOCUMENT", "Workbook structure is invalid.") from exc
+    items: list[tuple[str, str, dict]] = []
+    warnings: list[WarningItem] = []
+    comments = False
+    try:
+        for sheet in workbook.worksheets:
+            spans: dict[tuple[int, int], tuple[int, int]] = {}
+            for merged in sheet.merged_cells.ranges:
+                spans[(merged.min_row, merged.min_col)] = (merged.max_row - merged.min_row + 1,
+                                                          merged.max_col - merged.min_col + 1)
+            # _cells holds only cells that exist: safe for sparse sheets with huge dimensions.
+            for (row, col), cell in sorted(sheet._cells.items()):
+                if cell.comment is not None:
+                    comments = True
+                if not _translatable(cell):
+                    continue
+                if len(items) >= cap:
+                    raise TranslationError("TEXT_TOO_LONG", "Workbook has too many text cells.")
+                meta: dict[str, Any] = {"sheet": sheet.title, "row": row - 1, "col": col - 1,
+                                        "cell": cell.coordinate}
+                if sheet.sheet_state != "visible":
+                    meta["sheet_state"] = sheet.sheet_state
+                span = spans.get((row, col))
+                if span and span[0] > 1:
+                    meta["row_span"] = span[0]
+                if span and span[1] > 1:
+                    meta["column_span"] = span[1]
+                items.append(("table_cell", cell.value, meta))
+            if getattr(sheet, "_charts", None) or getattr(sheet, "_images", None):
+                warnings.append(WarningItem(code="UNSUPPORTED_PART",
+                                            message="Charts or images in the workbook are not translated."))
+    finally:
+        workbook.close()
+    if comments:
+        warnings.append(WarningItem(code="UNSUPPORTED_PART",
+                                    message="Cell comments are not translated."))
+    return _make_blocks(items, settings, warnings)
