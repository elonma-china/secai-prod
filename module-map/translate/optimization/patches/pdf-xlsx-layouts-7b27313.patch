+def _line_rects(textpage: Any, page_width: float
+                ) -> list[tuple[float, float, float, float, str]] | None:
+    """Line fragments (left, bottom, right, top, text); None when layout analysis is unsafe."""
+    count = textpage.count_rects()
+    if count < 2 or count > _MAX_RECTS:
+        return None
+    rects = []
+    for i in range(count):
+        left, bottom, right, top = textpage.get_rect(i)
+        text = textpage.get_text_bounded(left, bottom, right, top)
+        if not text.strip():
+            continue
+        # Vertical writing (tall boxes holding several glyphs): pdfium order is already right.
+        if len(text.strip()) > 1 and (top - bottom) > 1.5 * (right - left):
+            return None
+        # pdfium splits one visual line at every font/run change: glue near-touching fragments
+        # back together so only real gaps (columns, table cells) remain separate.
+        if rects:
+            pl, pb, pr, pt, ptext = rects[-1]
+            height = max(top - bottom, 1.0)
+            overlap = min(top, pt) - max(bottom, pb)
+            gap = left - pr
+            if overlap >= 0.5 * min(height, pt - pb) and 0 <= gap < 1.5 * height:
+                glue = "" if (gap < 0.3 * height or ptext.endswith(" ") or text.startswith(" ")
+                              or _CJK.match(text[:1]) or _CJK.match(ptext[-1:])) else " "
+                rects[-1] = (pl, min(pb, bottom), max(pr, right), max(pt, top), ptext + glue + text)
+                continue
+        rects.append((left, bottom, right, top, text))
+    rects = [(l, b, r, t, x.strip()) for l, b, r, t, x in rects]
+    return rects if len(rects) >= 2 else None
+
+
+def _gap(items: list, axis: int, minimum: float) -> float | None:
+    """First empty band along an axis (0 = x projection, 1 = y projection); returns its middle."""
+    lo, hi = (0, 2) if axis == 0 else (1, 3)
+    spans = sorted((item[lo], item[hi]) for item in items)
+    edge = spans[0][1]
+    for start, end in spans[1:]:
+        if start - edge >= minimum:
+            return (start + edge) / 2
+        edge = max(edge, end)
+    return None
+
+
+def _order(items: list, width: float, depth: int = 0) -> list[list]:
+    """XY-cut: split on page-wide white bands; prose columns are read column by column."""
+    if len(items) < 2 or depth > 40:
+        return [items]
+    heights = sorted(item[3] - item[1] for item in items)
+    line_h = max(heights[len(heights) // 2], 1.0)
+    h_cut = _gap(items, 1, 1.2 * line_h)
+    v_cut = _gap(items, 0, max(10.0, 0.02 * width))
+
+    def split(axis_cut: float, axis: int) -> tuple[list, list]:
+        lo, hi = (0, 2) if axis == 0 else (1, 3)
+        a = [i for i in items if (i[lo] + i[hi]) / 2 < axis_cut]
+        b = [i for i in items if (i[lo] + i[hi]) / 2 >= axis_cut]
+        return a, b
+
+    prose = False
+    if v_cut is not None:
+        left, right = split(v_cut, 0)
+        prose = all(len(side) >= 3 and sorted(len(i[4]) for i in side)[len(side) // 2] >= 25
+                    for side in (left, right))
+    if v_cut is not None and prose:
+        left, right = split(v_cut, 0)
+        if left and right:
+            return _order(left, width, depth + 1) + _order(right, width, depth + 1)
+    if h_cut is not None:
