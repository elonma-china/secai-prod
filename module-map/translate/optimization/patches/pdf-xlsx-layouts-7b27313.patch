+def _render_region(items: list) -> str:
+    """Lines of a region; widely separated fragments on one row (table cells) stay separate."""
+    heights = sorted(item[3] - item[1] for item in items)
+    median = max(heights[len(heights) // 2], 1.0)
+    rows: dict[int, list] = {}
+    for item in items:
+        rows.setdefault(round(item[3] / (median / 2)), []).append(item)
+    out: list[tuple[str, bool]] = []
+    for key in sorted(rows, reverse=True):
+        row = sorted(rows[key], key=lambda i: i[0])
+        gaps = [b[0] - a[2] for a, b in zip(row, row[1:])]
+        if gaps and max(gaps) >= 3 * median:
+            out.append(("\n\n".join(i[4] for i in row), True))
+        else:
+            out.append((_join([i[4] for i in row]), False))
+    text = out[0][0]
+    for (prev, prev_cell), (cur, cur_cell) in zip(out, out[1:]):
+        text += ("\n\n" if prev_cell or cur_cell else "\n") + cur
+    return text
+
+
+def _reading_order(rects: list, width: float, plain: str) -> str | None:
