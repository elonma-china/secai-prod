+def _split(raw: bytes) -> list[Image.Image]:
+    """Giống _prepare nhưng CHƯA mã hóa: chỉ cắt dải + bỏ dải trắng. Mã hóa (phóng + PNG, phần tốn CPU) làm song song từng dải."""
+    from PIL import ImageStat
+    if len(raw) > 10 * 1024 * 1024:
+        raise ValueError("image limit")
+    im = Image.open(io.BytesIO(raw)).convert("RGB")
+    if im.width * im.height > 20_000_000 or max(im.size) > 10_000:
+        raise ValueError("pixel limit")
+    out = []
+    for part in split_strips(im):
+        t = part.convert("L"); t.thumbnail((256, 256))
+        if ImageStat.Stat(t).stddev[0] < 4.0:
+            continue
+        out.append(part)
+    return out
+
+
+def _encode(part: Image.Image) -> bytes:
+    buf = io.BytesIO(); part.thumbnail((10_000, 10_000))
+    _fit(part).save(buf, format="PNG")
+    return buf.getvalue()
+
+
+async def _ocr_strip(part: Image.Image, prompt: str, cap: int) -> str:
+    """Mã hóa dải rồi OCR ngay (dải đầu không phải đợi các dải sau được mã hóa)."""
+    png = await asyncio.to_thread(_encode, part)
+    return await ocr_one(png, prompt, cap)
+
