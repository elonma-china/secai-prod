+def _display_value(cell: Any) -> str | None:
+    """Ô KHÔNG dịch (số, ngày, công thức, chuỗi không có chữ như '192.168.10.25:8443') vẫn phải có mặt trong kết quả,
+    đúng vị trí, dưới dạng khối literal giữ nguyên — nếu không bản dịch/preview làm MẤT thông tin."""
+    value = cell.value
+    if value is None:
+        return None
+    if isinstance(value, bool):
+        return "TRUE" if value else "FALSE"
+    if hasattr(value, "isoformat"):
+        return value.isoformat()
+    text = str(value)
+    return text if text.strip() else None
+
