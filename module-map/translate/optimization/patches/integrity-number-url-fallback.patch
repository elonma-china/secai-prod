+    # A URL/e-mail glued to a footnote digit in extracted PDF text ("7https://github.com/x") is still that
+    # URL; its left edge is the scheme, so only the right boundary is checked.
+    left = "" if re.match(r"(?:https?|ftp)://|www\\.", core, re.I) else r"(?:(?<![A-Za-z0-9_.:/\\-])|(?<=[^/]:))"
+    if re.search(left + re.escape(core) + r"(?![A-Za-z0-9_/\\-]|:(?![0-9])|\.[A-Za-z0-9])", source) is not None:
+        return True
+    # Localised digit grouping ("25,000" -> "25.000", "3.5" -> "3,5") keeps the same digits: accept it.
+    if re.fullmatch(r"\d[\d.,\u00a0\u202f ]*\d|\d", core):
+        digits = re.sub(r"\D", "", core)
+        # table rows put many numbers in one run ("0.312 0 0 0"); the digits must still occur in order.
+        return any(digits in re.sub(r"\D", "", m) for m in re.findall(r"\d(?:[\d.,\u00a0\u202f ]*\d)?", source))
