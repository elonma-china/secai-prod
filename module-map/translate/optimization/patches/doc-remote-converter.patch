+def _remote_converter(settings: TranslationSettings) -> str | None:
+    url = (getattr(settings, "converter_url", "") or "").rstrip("/")
+    if not url:
+        return None
+    if not url.startswith(("http://", "https://")):
+        raise TranslationError("DEPENDENCY_UNAVAILABLE", "DOC converter is unavailable.")
+    return url
+
+
+def _convert_remote(url: str, path: Path, work_dir: Path, settings: TranslationSettings) -> Path:
+    """Gửi .doc tới dịch vụ converter riêng (sandbox ở đó); nhận .docx."""
+    import httpx
+
+    try:
+        response = httpx.post(url + "/convert", content=path.read_bytes(), timeout=settings.converter_timeout_seconds + 5,
+                              headers={"Authorization": f"Bearer {settings.converter_token}"}, trust_env=False)
+    except httpx.TimeoutException as exc:
+        raise TranslationError("PROCESSING_TIMEOUT", "DOC conversion timed out.") from exc
+    except httpx.HTTPError as exc:
+        raise TranslationError("DEPENDENCY_UNAVAILABLE", "DOC converter is unavailable.") from exc
+    if response.status_code == 504:
+        raise TranslationError("PROCESSING_TIMEOUT", "DOC conversion timed out.")
+    if response.status_code in {401, 403, 429, 502, 503}:
+        raise TranslationError("DEPENDENCY_UNAVAILABLE", "DOC converter is unavailable.")
+    if response.status_code != 200 or not response.content.startswith(b"PK"):
+        raise TranslationError("CORRUPT_DOCUMENT", "DOC conversion failed.")
+    result = work_dir / "document.docx"
+    result.write_bytes(response.content)
+    return result
+
+
