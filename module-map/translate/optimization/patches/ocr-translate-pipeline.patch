+"""Dịch suy đoán (pipelining OCR -> dịch).
+
+Trong khi OCR còn chạy (dải/trang sau), các đoạn (chunk) văn bản ĐÃ ỔN ĐỊNH được dịch trước. Kết quả chỉ được dùng khi
+`translate_blocks` sau đó tính ra đúng chunk đó (so khớp chuỗi sau khi quy chuẩn tiền tố placeholder, cùng cặp ngôn ngữ);
+khác thì bỏ (hủy) và dịch lại như cũ => kết quả cuối giống nhánh không pipeline, chỉ sớm hơn. Mọi kiểm tra literal/chất
+lượng vẫn chạy trên kết quả này trong `translate_blocks`."""
+from __future__ import annotations
+
+import asyncio
+import logging
+import math
+
+from .types import DocumentBlock, TranslationError
+
+log = logging.getLogger("secai.translate.spec")
+_CANON = "⟦T@:"
+_MIN_AUTO_LETTERS = 60
+
+
+class Speculator:
+    def __init__(self, context, salt: bytes, source_lang: str, target_lang: str):
+        self.context = context
+        self.salt = salt
+        self.source_lang = source_lang
+        self.target_lang = target_lang
+        self._cache: dict[tuple[str, str, str], tuple[str, asyncio.Future]] = {}
+        self._all: list[asyncio.Future] = []
+        self.started = 0
+        self.hits = 0
+        self.closed = False
+        self._src: str | None = None if source_lang == "auto" else source_lang
+        self._est_total: int | None = None
+        self.pinned_maximum: int | None = None  # chỉ đặt khi bật spec_pin_estimate (PDF lớn: cỡ chunk theo ước lượng)
+        self.disabled = False
+
+    # ---- ngôn ngữ nguồn ------------------------------------------------
+    async def _resolve_src(self, text: str) -> str | None:
+        if self._src is not None:
+            return self._src
+        if sum(c.isalpha() for c in text) < _MIN_AUTO_LETTERS:
+            return None
+        from .service import detect_source_language
+        try:
+            found = await asyncio.to_thread(detect_source_language, (DocumentBlock(
+                id="s", kind="paragraph", order=0, text=text, metadata={}),))
+        except Exception:
+            return None
+        self._src = found
+        return found
+
+    # ---- chunk -----------------------------------------------------------
+    def _maximum(self, src: str, total_chars: int) -> int:
+        from .service import compute_maximum
+        return compute_maximum(self.context, src, total_chars)
+
+    async def submit(self, text: str, *, final: bool, total_chars: int | None = None,
+                     pin: bool = False) -> None:
+        """Không bao giờ làm hỏng job: mọi lỗi của nhánh suy đoán chỉ bị bỏ qua (job dịch như cũ)."""
+        try:
+            await self._submit(text, final=final, total_chars=total_chars, pin=pin)
+        except Exception:
+            log.exception("speculative submit failed (ignored)")
+
+    async def _submit(self, text: str, *, final: bool, total_chars: int | None = None,
+                      pin: bool = False) -> None:
+        """text = văn bản của MỘT khối. final=False: văn bản đang lớn dần (chỉ dùng phần tới dòng trọn vẹn cuối,
+        bỏ chunk cuối). pin=True: ghim cỡ chunk theo ước lượng tổng ký tự (PDF nhiều trang)."""
+        if self.closed or self.disabled or not text.strip():
+            return
+        if not final:
+            cut = text.rfind("\n")
+            if cut <= 0:
+                return
+            text = text[:cut + 1]
+        src = await self._resolve_src(text)
+        tgt = self.target_lang
+        if src is None or src == tgt:
+            return
+        from .service import _PLACEHOLDER, _chunks, _opaque_token
+        from .technical_tokens import protect_literals
+        if _opaque_token(text):
+            return
+        if total_chars is None:
+            total_chars = len(text)
+        maximum = self._maximum(src, total_chars)
+        if pin:
+            # PDF nhiều trang: tổng ký tự (quyết định cỡ chunk thích ứng) chỉ biết sau khi OCR hết. Mặc định chỉ chạy suy
+            # đoán khi ước lượng cận trên cho thấy cỡ chunk sẽ là mức sàn 160 (giống hệt nhánh không pipeline); nếu tài
+            # liệu lớn hơn thì tắt (dịch như cũ). spec_pin_estimate=True: ghim cỡ chunk theo ước lượng (chunk khác baseline).
+            if self.pinned_maximum is None:
+                if getattr(self.context.settings, "spec_pin_estimate", False):
+                    self.pinned_maximum = maximum
+                elif maximum != self._maximum(src, 0):
+                    self.disabled = True
+                    return
+            if self.pinned_maximum is not None:
+                maximum = self.pinned_maximum
+        protected = protect_literals(text, self.salt)
+        if _PLACEHOLDER.fullmatch(protected.text.strip()):
+            return
+        chunks = _chunks(protected.text, maximum=maximum)
+        if not final:
+            chunks = chunks[:-1]
+        for chunk in chunks:
+            if len(chunk) > 6000 or not chunk.strip():
+                continue
+            key = (src, tgt, chunk.replace(protected._prefix, _CANON))
+            if key in self._cache:
+                continue
+            fut = asyncio.ensure_future(self.context.translate_quiet(chunk, src, tgt))
+            fut.add_done_callback(lambda f: f.cancelled() or f.exception())  # đã "nhận" lỗi, tránh cảnh báo
+            self._cache[key] = (protected._prefix, fut)
+            self._all.append(fut)
+            self.started += 1
+            log.debug("spec start #%d len=%d final=%s", self.started, len(chunk), final)
+
+    async def take(self, chunk: str, src: str, tgt: str, prefix: str) -> str | None:
+        """Kết quả dịch suy đoán cho đúng chunk này (đã đổi về tiền tố hiện tại) hoặc None."""
+        entry = self._cache.get((src, tgt, chunk.replace(prefix, _CANON)))  # không pop: chunk trùng dùng lại (MT tất định)
+        if entry is None:
+            return None
+        spec_prefix, fut = entry
+        try:
+            response = await fut
+        except asyncio.CancelledError:
+            if fut.cancelled() or (fut.done() and isinstance(fut.exception(), asyncio.CancelledError)):
+                return None  # bị hủy phía suy đoán (không phải job dừng): dịch lại bình thường
+            raise
+        except TranslationError:
+            return None
+        if not response.strip():
+            return None
+        self.hits += 1
+        # MT hay đổi ⟦ thành ⟨ nên chỉ thay phần hex (24 ký tự, duy nhất) của tiền tố, không thay cả "⟦T<hex>:".
+        return response.replace(spec_prefix[2:-1], prefix[2:-1]) if spec_prefix != prefix else response
+
+    def close(self) -> None:
+        self.closed = True
+        for fut in self._all:
+            if not fut.done():
+                fut.cancel()
+        log.info("speculative translate: started=%d hits=%d wasted=%d", self.started, self.hits,
+                 max(0, self.started - self.hits))
