+_OPAQUE_SPECIAL = frozenset("@#$%^&*_+=[]{}|\\<>~/`")
+
+
+def _opaque_token(text: str) -> bool:
+    """Một token ASCII duy nhất (không khoảng trắng) có chữ số hoặc ký tự đặc biệt — mật khẩu, khóa, hostname, IP:cổng,
+    mã... — không phải câu để dịch. Đưa qua model thì dễ bị dịch/đổi ('P@ss!w0rd' -> 'Mật khẩu'): giữ NGUYÊN VĂN.
+    Chuỗi có chữ Việt/CJK/... (không phải ASCII) vẫn đi qua đường dịch bình thường."""
+    t = text.strip()
+    if not t or len(t) > 512 or not t.isascii() or any(c.isspace() for c in t):
+        return False
+    return any(c.isdigit() or c in _OPAQUE_SPECIAL for c in t)
+
+
+async def _gather_cancel_on_error(coros):
+    """gather giữ thứ tự; lỗi đầu tiên hủy phần còn lại (không để tác vụ mồ côi gọi model)."""
+    tasks = [asyncio.ensure_future(c) for c in coros]
+    try:
+        return await asyncio.gather(*tasks)
+    except BaseException:
+        for task in tasks:
+            task.cancel()
+        await asyncio.gather(*tasks, return_exceptions=True)
+        raise
+
 
