     async def translate(self, text: str, source_lang: TargetLang,
                         target_lang: TargetLang, *, timeout_seconds: float | None = None) -> str:
+        """Hedged call: a request that has not answered after ``hedge`` seconds (a stalled
+        connection; a normal call takes ~1 s) is raced against a second identical one, so a
+        hung socket costs seconds instead of the full timeout. Translation is idempotent."""
+        hedge = 4 + len(text) / 40
+        first = asyncio.ensure_future(self._translate(text, source_lang, target_lang,
+                                                      timeout_seconds=timeout_seconds))
+        try:
+            done, _ = await asyncio.wait({first}, timeout=hedge)
+        except asyncio.CancelledError:
+            first.cancel()
+            raise
+        if done:
+            return first.result()
+        second = asyncio.ensure_future(self._translate(text, source_lang, target_lang,
+                                                       timeout_seconds=timeout_seconds))
+        pending = {first, second}
+        failure: BaseException | None = None
+        try:
+            while pending:
+                done, pending = await asyncio.wait(pending, return_when=asyncio.FIRST_COMPLETED)
+                for task in done:
+                    if task.exception() is None:
+                        return task.result()
+                    failure = task.exception()
+        finally:
+            for task in (first, second):
+                if not task.done():
+                    task.cancel()
+        raise failure  # type: ignore[misc]
