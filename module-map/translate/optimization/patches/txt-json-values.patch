+_JSON_STRING = re.compile(r'"(?:[^"\\\n]|\\.)*"')
+
+
+def _json_blocks(text: str) -> list[tuple[str, str, dict]] | None:
+    """JSON text: only string VALUES are translatable; keys and punctuation stay verbatim.
+
+    Each value becomes a block holding the decoded string, with the text around it in
+    ``metadata["json_affix"]`` so the translation is re-escaped and wrapped back and the file
+    still parses. Structure between values is emitted as literal blocks (the output joins blocks
+    with newlines, which is only inserted between JSON tokens).
+    """
+    stripped = text.strip()
+    if not stripped or stripped[0] not in "{[":
+        return None
+    try:
+        if not isinstance(json.loads(stripped), (dict, list)):
+            return None
+    except ValueError:
+        return None
+    items: list[tuple[str, str, dict]] = []
+    for line in text.split("\n"):
+        pieces: list[tuple[int, int]] = []
+        for match in _JSON_STRING.finditer(line):
+            if re.match(r"\s*:", line[match.end():]):
+                continue  # object key
+            pieces.append((match.start(), match.end()))
+        if not pieces:
+            items.append(("literal", line, {}))
+            continue
+        previous_end = 0
+        for index, (start, end) in enumerate(pieces):
+            if index:
+                items.append(("literal", line[previous_end:start], {}))
+            prefix = (line[:start] if not index else "") + '"'
+            suffix = '"' + (line[end:] if index == len(pieces) - 1 else "")
+            items.append(("paragraph", json.loads(line[start:end]), {"json_affix": [prefix, suffix]}))
+            previous_end = end
+    return items
+
