# Copy to a private path and fill the existing DuyTa vLLM endpoint and token.
# The launcher reads only provider and OCR keys from this file.
QWEN_BASE_URL=http://127.0.0.1:18080/v1
QWEN_MODEL=DuyTa/Cyber-F1-AWQ
QWEN_API_KEY=

# Enable image jobs only after an isolated OCR service is reachable via a private tunnel.
# TRANSLATE_V2_OCR_BASE_URL=http://127.0.0.1:18083
# TRANSLATE_V2_OCR_MODEL=<served-ocr-model-id>
# TRANSLATE_V2_OCR_API_KEY=<private-token>
