# ── .env.bench — cấu hình bench KPI AI turnkey ─────────────────────────────────
#   cp .env.bench.example .env.bench   →   điền URL   →   bash scripts/bench.sh
# KHÔNG commit .env.bench (chứa secret). File này chỉ là mẫu.
#
# Ví dụ prefill = stack vLLM on-prem hiện tại (38.65.239.54, ports remap NAT).

# ── LLM under test (OpenAI-compatible: vLLM / DeepSeek / TGI…) ──────────────────
# PHẢI có /v1 cuối nếu server theo chuẩn OpenAI.
LLM_BASE_URL=http://38.65.239.54:46940/v1
LLM_API_KEY=sk-secai2026                         # nginx tự inject; placeholder là đủ
LLM_MODEL=nvidia/Qwen3-30B-A3B-NVFP4           # đúng id server expose (GET /v1/models)

# ── Embedding (PHẢI khớp model đã index Qdrant cve_kb = bge-m3) ──────
EMBED_URL=http://38.65.239.54:58956              # client tự nối /v1/embeddings
EMBED_MODEL=BAAI/bge-m3

# ── Reranker ───────────────────────────────────────────────────────────────────
RERANK_URL=http://38.65.239.54:55963             # client tự nối /v1/rerank
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B

# ── Qdrant (KB cve_kb ~327k CVE) — cần cho retrieval + entity-grounding ────────
QDRANT_URL=http://YOUR_QDRANT_HOST:6333
QDRANT_COLLECTION=cve_kb

# ── Backend secAI (drive full agent sinh đáp án 1000 mẫu) ──────────────────────
ACC_BASE=http://YOUR_BACKEND_HOST:4096
OPENCODE_SERVER_USERNAME=Fable5                  # basic auth web/backend (nếu bật)
OPENCODE_SERVER_PASSWORD=
# Provider/model agent gọi — PHẢI khớp provider Qwen đã cấu hình ở backend.
# vLLM on-prem qua provider secai-llm thường expose model id "default":
ACC_PROVIDER=secai-llm
ACC_MODEL=default
ACC_AGENT=build
# (Nếu backend vẫn dùng DeepSeek cloud: ACC_PROVIDER=deepseek · ACC_MODEL=deepseek-v4-flash)

# ── RAGAS judge (faithfulness) — ĐỘC LẬP với model under test ───────────────────
# Thiếu key → bench tự SKIP faithfulness (không fail cả run).
RAGAS_JUDGE_BASE_URL=https://api.openai.com/v1
RAGAS_JUDGE_API_KEY=
RAGAS_JUDGE_MODEL=gpt-4o-mini

# ── BM25 artifacts (retrieval hybrid) ──────────────────────────────────────────
# Mặc định bench.sh tự set DATA_ROOT=<repo>/data (đã có knowledge_base/bm25_cve_kb).
# Chỉ set nếu để KB ở nơi khác:
# DATA_ROOT=/path/to/data
# BM25_DIR=/path/to/data/knowledge_base/bm25_cve_kb
