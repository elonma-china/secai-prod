# SecAI stack - cấu hình. `./bootstrap.sh init` tạo .env từ tệp này và tự sinh secret; điền tay các dòng còn trống
# trong khối ENDPOINTS/PATHS rồi chạy `./bootstrap.sh preflight`. Mỗi dòng: một biến + một chú thích phía trên.
# Quy ước: khoá/mật khẩu để TRỐNG ở đây (init sinh hoặc nhập tay); tên model để TRỐNG (phải khớp đúng tên serving).

# ── ENDPOINTS ──────────────────────────────────────────────────────────────────────────────────────
# Profile bật (phân tách bằng dấu phẩy): exploit, translation, report, review. Core luôn chạy.
COMPOSE_PROFILES=exploit,translation,report,review
# URL OpenAI-compatible của LLM chat/agent (kèm /v1).
QWEN_BASE_URL=
# Tên model LLM đúng như serving công bố (nhập tay).
QWEN_MODEL=
# Cửa sổ ngữ cảnh LLM (token) cho gateway và engine.
QWEN_CONTEXT_WINDOW=131072
# Nhà cung cấp LLM của gateway.
LLM_PROVIDER=vllm
# Nhiệt độ sinh mặc định (giá trị prod).
LLM_TEMPERATURE=0.3
# URL dịch vụ embedding.
EMBEDDING_API_URL=
# Tên model embedding (nhập tay, phải khớp serving).
EMBEDDING_MODEL=
# URL dịch vụ rerank.
RERANKER_API_URL=
# Tên model rerank (nhập tay, phải khớp serving).
RERANKER_MODEL=
# Collection Qdrant của kho CVE.
QDRANT_COLLECTION=cve_kb_hybrid
# Chế độ airgap: chặn truy cập internet từ gateway.
AIRGAP=true
# Origin được phép gọi API (CORS).
ALLOWED_ORIGINS=*
# Bộ phân loại đầu vào (injection/off-topic).
INPUT_CLASSIFIER_ENABLED=true
# Prod KHÔNG chặn off-topic (mặc định mã nguồn là true, nên phải ghi tường minh).
INPUT_CLASSIFIER_BLOCK_OFFTOPIC=false
# Cascade LLM kiểm tra injection (giá trị prod).
INJECTION_CASCADE_ENABLED=true
# Timeout (giây) của cascade injection.
INJECTION_CASCADE_TIMEOUT_S=20
# Giới hạn tốc độ API: tắt như prod.
RATE_LIMIT_ENABLED=false
# Tìm kiếm web: tắt như prod.
WEB_SEARCH_ENABLED=false
# Backend recon của bughunt (giá trị prod).
BUGHUNT_RECON_BACKEND=host
# PoC-Verify (executor ngoài stack): tắt.
VERIFY_ENABLED=false
# Mục tiêu exploit-v2 được phép (host/CIDR, phân cách dấu phẩy), ví dụ dải mạng lab 192.168.96.0/20. Trống (và không
# VERIFY_ALLOW_ALL=true) thì gateway trả 403 cho mọi yêu cầu PoC; preflight đòi khi bật profile exploit.
VERIFY_ALLOWED_TARGETS=
# Thực thi lệnh trực tiếp: tắt.
EXEC_ENABLED=false
# Đường dẫn searchsploit trong image gateway.
SEARCHSPLOIT_BIN=/app/bin/searchsploit
# Địa chỉ bind của gateway trên host.
GATEWAY_BIND=0.0.0.0
# Cổng gateway trên host.
GATEWAY_HOST_PORT=8131
# Địa chỉ bind backend báo cáo (profile report).
REPORT_BIND=127.0.0.1
# Cổng backend báo cáo trên host.
REPORT_HOST_PORT=18183
# Địa chỉ bind UI review (profile review).
REVIEW_BIND=127.0.0.1
# Cổng UI review trên host.
REVIEW_HOST_PORT=5174
# Bật API review ở gateway; init đặt true khi COMPOSE_PROFILES có review.
REVIEW_ENABLED=
# URL gateway dịch; init đặt http://translation-gateway:18185 khi COMPOSE_PROFILES có translation.
TRANSLATION_UPSTREAM_URL=

# ── SECRETS ────────────────────────────────────────────────────────────────────────────────────────
# Khoá model (QWEN/EMBEDDING/RERANKER/ORCAROUTER/OCR/SPECIALIST) NHẬP TAY; còn lại `init` sinh 64 ký tự hex.
# Khoá API của LLM (nhập tay).
QWEN_API_KEY=
# Khoá API của embedding (nhập tay).
EMBEDDING_API_KEY=
# Khoá API của rerank (nhập tay).
RERANKER_API_KEY=
# Khoá OrcaRouter cho engine exploit (nhập tay, có thể để trống nếu chỉ dùng LLM nội bộ).
ORCAROUTER_API_KEY=
# Khoá API của OCR (nhập tay, profile translation).
TRANSLATE_V2_OCR_API_KEY=
# Khoá API của model dịch chuyên dụng cho file/live (nhập tay, profile translation).
TRANSLATE_V2_SPECIALIST_API_KEY=
# Khoá API của model dịch chuyên dụng đa ngôn ngữ (nhập tay, profile translation).
MULTILANG_SPECIALIST_API_KEY=
# Mật khẩu Neo4j (init sinh); gateway chỉ nhận qua env_file.
NEO4J_PASSWORD=
# Khoá quản trị API gateway (init sinh).
ADMIN_API_KEY=
# Tài khoản UI log.
LOGS_UI_USERNAME=admin
# Mật khẩu UI log (init sinh).
LOGS_UI_PASSWORD=
# Khoá ký phiên UI log (init sinh).
LOGS_UI_SESSION_SECRET=
# Khoá API báo cáo (init sinh); để trống thì API báo cáo trả 404.
REPORT_API_KEY=
# Mật khẩu Basic của engine pentestcode, user ias (init sinh).
IAS_SERVER_PASSWORD=
# Token gateway <-> converter .doc; trống thì converter từ chối mọi yêu cầu (init sinh).
TRANSLATE_V2_CONVERTER_TOKEN=

# ── PATHS & IMAGES ─────────────────────────────────────────────────────────────────────────────────
# Tên project compose.
COMPOSE_PROJECT_NAME=secai-stack
# Gốc dữ liệu (đường dẫn tuyệt đối): exploitdb, poc, poc-sources, exploitdb-mcp-server, qdrant, _state.
DATA_ROOT=
# Image gateway, bắt buộc có tag cố định (không :latest), ví dụ secai-agent-gateway:main-<sha8>-<ngày>.
GATEWAY_IMAGE=
# Image engine pentestcode cho profile exploit (dựng từ images/pentestcode-vm).
VM_IMAGE=
# Image converter .doc cho profile translation (dựng từ images/converter).
CONVERTER_IMAGE=
# Image UI review cho profile review (dựng từ images/review-ui).
REVIEW_UI_IMAGE=
# Thư mục tokenizer HY-MT2 (tokenizer.json, tokenizer_config.json); tương đối thì tính từ thư mục stack.
TOKENIZER_DIR=./tokenizer
# Nguồn PoC trong container gateway (Task 1: agent đọc PoC từ đây).
AGENT_POC_SOURCES_PATH=/srv/secai-data/poc-sources
# Tên mạng lab PoC mà container exploit và gateway cùng tham gia.
POC_LABS_NETWORK=poc-labs-internal
# true nếu mạng lab đã tồn tại ngoài compose; false để compose tự tạo.
POC_LABS_EXTERNAL=false

# ── POOL ───────────────────────────────────────────────────────────────────────────────────────────
# Số slot mỗi container VM (1..99); pool = 2 x VM_SLOTS (vm-a, vm-b).
VM_SLOTS=12
# Gid chung gateway (group_add) và HOME slot của VM để gateway dọn được engagements; không cần tồn tại trong image.
VM_SHARED_GID=10100
# Pool tường minh do `init` tính từ VM_SLOTS bằng lib/pool.sh; không sửa tay (đổi VM_SLOTS thì xoá dòng này rồi init lại).
IAS_SERVER_POOL=
# Phải là 0: pool chỉ lấy từ IAS_SERVER_POOL, không sinh pool động theo GPU.
IAS_POOL_GPU_COUNT=0
# Giới hạn RAM mỗi container VM.
VM_MEM_LIMIT=48g
# Giới hạn số tiến trình mỗi container VM.
VM_PIDS_LIMIT=16384

# ── TRANSLATION ────────────────────────────────────────────────────────────────────────────────────
# Số chunk dịch song song (giá trị prod).
TRANSLATE_CHUNK_CONCURRENCY=12
# URL OCR (OpenAI-compatible).
TRANSLATE_V2_OCR_BASE_URL=
# Tên model OCR (nhập tay, phải khớp serving).
TRANSLATE_V2_OCR_MODEL=
# URL model dịch chuyên dụng cho file.
TRANSLATE_V2_SPECIALIST_BASE_URL=
# Tên model dịch chuyên dụng cho file (nhập tay, phải khớp serving).
TRANSLATE_V2_SPECIALIST_MODEL=
# URL model dịch chuyên dụng đa ngôn ngữ (live).
MULTILANG_SPECIALIST_BASE_URL=
# Tên model dịch chuyên dụng đa ngôn ngữ (nhập tay, phải khớp serving).
MULTILANG_SPECIALIST_MODEL=
