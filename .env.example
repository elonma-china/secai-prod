# secai-agent-gateway configuration. Copy to .env and fill in.
# The gateway is deliberately unauthenticated — run only behind private ingress/VPN.
# All keys map 1:1 to secai_gateway.config.Settings (case-insensitive).

# ── LLM provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_CONTEXT_WINDOW=131072
# vLLM/Qwen fallback (used when LLM_PROVIDER=vllm)
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_API_KEY=not-needed
QWEN_MODEL=Qwen/Qwen3-32B
QWEN_CONTEXT_WINDOW=32768

# ── Retrieval: Qdrant + embedding/reranker ───────────────────────────────────
QDRANT_URL=http://localhost:6333
EMBEDDING_API_URL=http://your-gpu-host:5546
RERANKER_API_URL=http://your-gpu-host:5834
EMBEDDING_API_KEY=sk-secai2026
RERANKER_API_KEY=sk-secai2026
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
BM25_DIR=/path/to/secai-data/bm25/bm25_cve_kb

# ── Knowledge graph: Neo4j ───────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474

# ── PoC / Exploit-DB (in-process) ────────────────────────────────────────────
EXPLOITDB_ROOT=/path/to/secai-data/exploitdb
SEARCHSPLOIT_BIN=./bin/searchsploit

# ── Conversation memory (Redis) — empty = in-memory dev/test fallback ─────────
REDIS_URL=redis://localhost:6379

# ── Gateway ──────────────────────────────────────────────────────────────────
GATEWAY_DB_PATH=./data/gateway.db
ADMIN_API_KEY=change-me-admin-key
# CORS: comma-separated frontend origins, or * for local demos
ALLOWED_ORIGINS=*

# ── Agent loop (optional) ────────────────────────────────────────────────────
# STEP_CAP=10
# TOOL_TIMEOUT_MS=30000
