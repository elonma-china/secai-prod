# ═══════════════════════════════════════════════════════════════════════════════
#  secai-docker — bộ Docker THỐNG NHẤT cho project SecAI/AIEngines (core stack).
#
#  Gộp BE gateway + Qdrant + Neo4j + Redis vào 1 compose project (network nội bộ
#  `secai-net`), đấu nối qua TÊN SERVICE (không còn localhost). Model LLM/embedding/
#  reranker VẪN gọi ra vast (202.122.49.242) qua HTTP — cấu hình trong .env.
#
#  Data dùng BIND-MOUNT thẳng vào dir local sẵn có (không nhân đôi ~20GB+):
#     /home/ict/AIEngines/secai/secai-data/...
#
#  Dùng:   ./up.sh            (khuyến nghị — dừng stack cũ, build, up, in danh sách)
#     hoặc: docker compose --env-file .env up -d --build
#
#  Gateway host port mặc định 8140 (coexist với native ias.id.vn :8131). Đổi bằng
#  GATEWAY_HOST_PORT trong .env hoặc: GATEWAY_HOST_PORT=8131 docker compose up -d
# ═══════════════════════════════════════════════════════════════════════════════
name: secai-docker

services:
  qdrant:
    image: qdrant/qdrant:v1.10.1
    container_name: secai-docker-qdrant
    restart: unless-stopped
    ulimits:                               # large collection opens many RocksDB .sst files
      nofile: { soft: 262144, hard: 262144 }
    ports:
      - "6333:6333"
      - "6334:6334"
    volumes:
      - ${SECAI_DATA_ROOT}/_state/qdrant_storage:/qdrant/storage
      - ${SECAI_DATA_ROOT}/qdrant:/qdrant/snapshots     # rw: Qdrant dọn snapshots/tmp lúc khởi động
    networks: [secai-net]
    healthcheck:
      test: ["CMD-SHELL", "bash -c 'echo > /dev/tcp/localhost/6333' 2>/dev/null || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 15
      start_period: 15s

  neo4j:
    image: neo4j:5.20-community
    container_name: secai-docker-neo4j
    restart: unless-stopped
    ports:
      - "7474:7474"
      - "7687:7687"
    environment:
      NEO4J_AUTH: neo4j/${NEO4J_PASSWORD:-secai2026}
      NEO4J_PLUGINS: '["apoc"]'
      NEO4J_server_memory_heap_initial__size: 512m
      NEO4J_server_memory_heap_max__size: 2g
    volumes:
      - ${SECAI_DATA_ROOT}/_state/neo4j_data:/data
      - ${SECAI_DATA_ROOT}/_state/neo4j_logs:/logs
    networks: [secai-net]
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://localhost:7474 || exit 1"]
      interval: 15s
      timeout: 10s
      retries: 20
      start_period: 30s

  redis:
    image: redis:7-alpine
    container_name: secai-docker-redis
    restart: unless-stopped
    command: ["redis-server", "--save", "60", "1", "--appendonly", "no"]
    ports:
      - "6379:6379"
    volumes:
      - secai-redis-data:/data
    networks: [secai-net]
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 5s

  gateway:
    build:
      context: ../secai-agent-gateway
      dockerfile: Dockerfile
    image: secai-agent-gateway:0.2.0
    container_name: secai-docker-gateway
    restart: unless-stopped
    env_file:
      - .env
    # Re-pin path + service-name settings to in-container values so host-oriented
    # values in .env can never leak into the container.
    environment:
      QDRANT_URL: http://qdrant:6333
      NEO4J_URI: bolt://neo4j:7687
      REDIS_URL: redis://redis:6379
      GATEWAY_DB_PATH: /app/data/gateway.db
      EXPLOITDB_ROOT: /srv/exploitdb
      POC_CATALOG_DB: /srv/poc/catalog.db
      POC_ARTIFACT_STORE: /srv/poc-store
      POC_SOURCES_ROOT: /srv/poc-sources
      INPUT_CLASSIFIER_ENABLED: "false"   # TẠM TẮT model classification (offtopic over-refusal) — 2026-09-03; xoá dòng này để bật lại
    ports:
      - "${GATEWAY_HOST_PORT:-8140}:8131"
    volumes:
      - secai-gw-data:/app/data                                     # sessions/ledger (writable)
      - ${SECAI_DATA_ROOT}/exploitdb:/srv/exploitdb:ro              # searchsploit corpus
      - ${SECAI_DATA_ROOT}/poc:/srv/poc                             # catalog.db (WAL → rw)
      - ${SECAI_DATA_ROOT}/poc/store:/srv/poc-store                 # fetched PoC artifacts
      - ${SECAI_DATA_ROOT}/poc-sources:/srv/poc-sources:ro          # cloned PoC sources (12GB)
    depends_on:
      qdrant:
        condition: service_healthy
      neo4j:
        condition: service_healthy
      redis:
        condition: service_healthy
    networks: [secai-net]

networks:
  secai-net:
    driver: bridge

volumes:
  secai-gw-data:
  secai-redis-data:
