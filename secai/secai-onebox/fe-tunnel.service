# systemd unit MẪU để giữ SSH tunnel FE→gateway sống bền + tự bật sau reboot máy FE.
#
#  Cài trên MÁY FE:
#    1) copy fe-tunnel.sh sang máy FE, ví dụ /opt/secai/fe-tunnel.sh (chmod +x)
#    2) copy SSH key (đã attach vào box) sang máy FE, ví dụ /home/<user>/.ssh/id_ed25519
#    3) sửa User=, ExecStart= path, và các Environment= dưới cho khớp máy FE
#    4) sudo cp fe-tunnel.service /etc/systemd/system/secai-fe-tunnel.service
#       sudo systemctl daemon-reload
#       sudo systemctl enable --now secai-fe-tunnel
#       systemctl status secai-fe-tunnel        # xem log; journalctl -u secai-fe-tunnel -f
#    5) FE trỏ GATEWAY_URL=http://127.0.0.1:8131  (kiểm tra: curl http://127.0.0.1:8131/health)
[Unit]
Description=SecAI FE→gateway SSH tunnel (localhost:8131 → box GPU 8131)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME_fe_user
# Trỏ tới fe-tunnel.sh trên máy FE:
ExecStart=/opt/secai/fe-tunnel.sh
# Cấu hình box GPU (đổi khi thuê instance khác / IP đổi):
Environment=REMOTE_HOST=38.65.239.54
Environment=REMOTE_PORT=20700
Environment=REMOTE_USER=root
Environment=SSH_KEY=/home/CHANGE_ME_fe_user/.ssh/id_ed25519
Environment=LOCAL_PORT=8131
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
