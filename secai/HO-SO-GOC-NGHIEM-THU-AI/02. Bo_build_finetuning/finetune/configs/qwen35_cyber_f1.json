  "peft": {
    "r": 8,
    "alpha": 16,
    "dropout": 0.0,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "gate_up_proj",
      "down_proj"
    ]
  },
  "logging": {
    "tensorboard_dir": "outputs/tensorboard/qwen35-cyber-f1-v2"
