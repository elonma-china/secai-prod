    {
      "name": "02 — Dịch text",
      "item": [
        {
          "name": "Text v3 — JSON",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/ai/v3/translate",
            "description": "Một đầu phải là vi, hai ngôn ngữ khác nhau. Xem capabilities trước khi chọn cặp. Trung: zh-Hans.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"{{text}}\",\n  \"source_lang\": \"{{source_lang}}\",\n  \"target_lang\": \"{{target_lang}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { pm.test(\"Có translated_text\", () => pm.expect(pm.response.json().translated_text).to.be.a(\"string\").and.not.empty); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Text v3 — SSE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "text/event-stream",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/ai/v3/translate/stream",
            "description": "HTTP 200 chưa đủ: phải có event final, không có event error. Postman có thể hiển thị response sau khi stream kết thúc.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"{{text}}\",\n  \"source_lang\": \"{{source_lang}}\",\n  \"target_lang\": \"{{target_lang}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"SSE Content-Type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/event-stream\"));",
                  "pm.test(\"Có final, DONE và không có event error\", () => {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.match(/event:\\s*final/);",
                  "    pm.expect(text).to.include(\"[DONE]\");",
                  "    pm.expect(text).not.to.match(/event:\\s*error/);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Text legacy — JSON",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
