 "components": {
  "schemas": {
   "BughuntRequest": {
    "properties": {
     "target": {
      "type": "string",
      "title": "Target"
     },
     "scope_note": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Scope Note"
     },
     "user_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "User Id"
     },
     "run_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Run Id"
     },
     "enable_exploit": {
      "type": "boolean",
      "title": "Enable Exploit",
      "default": false
     },
     "run_cve_sweep": {
      "type": "boolean",
      "title": "Run Cve Sweep",
      "default": true
     }
    },
    "additionalProperties": true,
    "type": "object",
    "required": [
     "target"
    ],
    "title": "BughuntRequest",
    "description": "POST /ai/bughunt/stream — a target-only BugHunter run."
   },
   "ExecRequest": {
    "properties": {
     "cmd": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Cmd"
     },
     "shell": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Shell"
     },
     "timeout_s": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Timeout S"
     },
     "privileged": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "Privileged"
     },
     "user_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "User Id"
     }
    },
    "additionalProperties": true,
    "type": "object",
    "title": "ExecRequest",
    "description": "POST /ai/exec — deliberately privileged raw executor API."
   },
   "ExploitAdvanceReplyRequest": {
    "properties": {
     "run_id": {
      "type": "string",
      "title": "Run Id",
      "description": "run_id từ event `question` (adv:xxx)."
     },
     "answer": {
      "type": "string",
      "title": "Answer",
      "description": "Câu trả lời/thông tin bổ sung từ user (endpoint, protocol, credential...)."
     },
     "user_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "User Id",
      "description": "Định danh người gọi (audit)."
     }
    },
    "additionalProperties": true,
    "type": "object",
    "required": [
     "run_id",
     "answer"
    ],
    "title": "ExploitAdvanceReplyRequest",
    "description": "POST /ai/exploit-advance/reply — cung cấp thông tin bổ sung cho lane1 đang paused."
   },
   "ExploitAdvanceRequest": {
    "properties": {
     "cve": {
      "type": "string",
      "title": "Cve",
      "description": "Mã CVE cần khai thác, ví dụ CVE-2017-5638."
     },
     "target": {
      "type": "string",
      "title": "Target",
      "description": "Target: host | host:port | URL (vd 10.0.0.5, 10.0.0.5:8080, http://10.0.0.5:8080)."
     },
     "port": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Port",
      "description": "Cổng target (nếu không suy ra được từ `target`)."
     },
     "command": {
      "type": "string",
      "title": "Command",
      "description": "Lệnh chứng minh RCE khi khai thác thành công (vd `id`, `cat /flag`).",
      "default": "id"
     },
     "auth": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Auth",
      "description": "Xác thực cho target cần đăng nhập: {headers?, cookies?, token?}."
     },
     "scope_note": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Scope Note",
      "description": "Ghi chú phạm vi/uỷ quyền (audit)."
     },
     "max_steps": {
      "type": "integer",
      "maximum": 20.0,
      "minimum": 1.0,
      "title": "Max Steps",
      "description": "Số vòng exploit→verify→sửa tối đa.",
      "default": 5
     },
     "step_timeout_s": {
      "type": "integer",
      "maximum": 1800.0,
      "minimum": 10.0,
      "title": "Step Timeout S",
      "description": "Timeout mỗi bước (giây).",
      "default": 180
     },
     "total_timeout_s": {
      "type": "integer",
      "maximum": 7200.0,
      "minimum": 30.0,
      "title": "Total Timeout S",
      "description": "Timeout toàn cục (giây).",
      "default": 900
     },
     "use_proxy": {
