  "/showcase-api/finetune/runs/{run_id}/log": {
   "get": {
    "tags": [
     "showcase-finetune"
    ],
    "summary": "Run Log",
    "operationId": "run_log_ai_finetune_runs__run_id__log_get",
    "parameters": [
     {
      "name": "run_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Run Id"
      }
     },
     {
      "name": "granularity",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "pattern": "^(epoch|step)$",
       "default": "step",
       "title": "Granularity"
      }
     },
     {
      "name": "max_points",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 2000,
       "minimum": 10,
       "default": 300,
       "title": "Max Points"
      }
