# Keep the build context small and secret-free.
# The image only needs: pyproject.toml, src/, bin/.

# Secrets — NEVER copy real config into the image/context.
.env
.env.*
!.env.example
# kpi_bench's template (no real secrets, same idea as !.env.example above) — the
# `.env.*` pattern above would otherwise also swallow this at any depth.
!kpi_bench/.env.bench.example

# Host virtualenv (huge, machine-specific) and Python caches.
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# Runtime state / logs / local SQLite DBs (mounted as a volume instead).
data/
*.log
*.db

# Not needed at runtime.
logs/
output/
.playwright-mcp/
.cocoindex_code/
.opencode/
tests/
test/
docs/
deploy/
demo/
evals/
evidence/
scripts/
pentestcode/
secai-fe-devspace/
secai-serving-vast/
kpi_eval_v2/
jev-ultrafast/
.git/
.git.bak-nested/
.gitignore
*.png
*.docx
*.zip
Untitled

# kpi_bench IS copied into the image (see Dockerfile `COPY kpi_bench`), but its
# run-churn/output dirs are not — they don't exist in a fresh checkout, but keep
# this belt-and-suspenders so a local test run never bloats a rebuild.
kpi_bench/runs/
kpi_bench/raw-logs/
kpi_bench/reports/
kpi_bench/**/__pycache__/
